{
  "api_base_url": "https://<your-vercel-domain>.vercel.app",
  "endpoints": {
    "generate_access_token": {
      "path": "/api/fyers/generate-access-token",
      "method": ["GET", "POST"],
      "description": "Automated headless login to fetch and save the Fyers access token to the database.",
      "request_payload": {
        "description": "Optional if environment variables are set on Vercel. Required if not set.",
        "example": {
          "fy_id": "XY12345",
          "totp_secret": "ABCDEFGHIJKLMNOPQRSTUVWXYZ123456",
          "pin": "1234",
          "client_id": "YOUR_FYERS_APP_ID",
          "secret_key": "YOUR_FYERS_SECRET_KEY"
        }
      },
      "response_structure": {
        "success": {
          "status": 200,
          "example": {
            "status": "success",
            "message": "Auto-login successful! Access token saved to Neon DB.",
            "data": {
              "access_token": "eyJhbGciOiJIUzI1NiIsInR5c..."
            }
          }
        },
        "error": {
          "status": [400, 500],
          "example": {
            "status": "error",
            "message": "Missing Fyers credentials. Please set FYERS_ID, FYERS_TOTP_SECRET..."
          }
        }
      }
    },
    "buy_call": {
      "path": "/api/buy/call",
      "method": "POST",
      "description": "Places a Market Intraday BUY order for a CALL option.",
      "request_payload": {
        "example": {
          "quantity": 50,
          "strike_price": 25000
        }
      },
      "response_structure": {
        "success": {
          "status": 200,
          "example": {
            "status": "success",
            "message": "Buy Call order placed successfully",
            "order_id": "813824819231",
            "symbol": "NSE:NIFTY24OCT25000CE",
            "quantity": 50
          }
        },
        "error": {
          "status": [400, 401, 500],
          "example": {
            "status": "error",
            "message": "Failed to place order with Fyers",
            "details": {
              "s": "error",
              "code": -429,
              "message": "Insufficient margins"
            }
          }
        }
      }
    },
    "buy_put": {
      "path": "/api/buy/put",
      "method": "POST",
      "description": "Places a Market Intraday BUY order for a PUT option.",
      "request_payload": {
        "example": {
          "quantity": 50,
          "strike_price": 25000
        }
      },
      "response_structure": {
        "success": {
          "status": 200,
          "example": {
            "status": "success",
            "message": "Buy Put order placed successfully",
            "order_id": "813824819232",
            "symbol": "NSE:NIFTY24OCT25000PE",
            "quantity": 50
          }
        }
      }
    },
    "sell_call": {
      "path": "/api/sell/call",
      "method": "POST",
      "description": "Places a Market Intraday SELL order for a CALL option.",
      "request_payload": {
        "example": {
          "quantity": 50,
          "strike_price": 25000
        }
      },
      "response_structure": {
        "success": {
          "status": 200,
          "example": {
            "status": "success",
            "message": "Sell Call order placed successfully",
            "order_id": "813824819233",
            "symbol": "NSE:NIFTY24OCT25000CE",
            "quantity": 50
          }
        }
      }
    },
    "sell_put": {
      "path": "/api/sell/put",
      "method": "POST",
      "description": "Places a Market Intraday SELL order for a PUT option.",
      "request_payload": {
        "example": {
          "quantity": 50,
          "strike_price": 25000
        }
      },
      "response_structure": {
        "success": {
          "status": 200,
          "example": {
            "status": "success",
            "message": "Sell Put order placed successfully",
            "order_id": "813824819234",
            "symbol": "NSE:NIFTY24OCT25000PE",
            "quantity": 50
          }
        }
      }
    }
  }
}